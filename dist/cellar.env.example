# cellar configuration — systemd EnvironmentFile (/etc/cellar/cellar.env)
# Copy to /etc/cellar/cellar.env and edit. Keep it root-only (chmod 600): it
# may hold the DB password.

# --- server ---
CEL_PORT=8080
CEL_LOG_LEVEL=info

# --- TLS (optional; serve HTTPS/WSS directly, no nginx) ---
# Set BOTH to PEM paths to terminate TLS in cellar itself. Both must be set, or
# startup fails (it never silently downgrades to plaintext). Leave unset to serve
# plaintext (e.g. behind a TLS-terminating reverse proxy).
# CEL_TLS_CERT=/etc/cellar/tls/fullchain.pem
# CEL_TLS_KEY=/etc/cellar/tls/privkey.pem
# Behind a reverse proxy you control, set to 1 so the client IP (rate limiting,
# audit) comes from X-Real-IP / X-Forwarded-For. Off by default (spoof-safe).
# CEL_TRUST_PROXY=0

# --- CORS (browser frontends on another origin) ---
# Lets a browser SPA on a different origin call the API. Comma list of allowed
# origins, or "*" for any. Unset (default) sends no CORS headers (same-origin
# only). Bearer-token APIs don't need credentials; only set CEL_CORS_CREDENTIALS=1
# if you use cookie-based auth (then "*" is replaced by the specific origin).
# CEL_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# CEL_CORS_CREDENTIALS=0

# --- observability ---
# GET /metrics serves Prometheus text-format metrics (requests, auth, session
# cache, DB pool, realtime, uptime). It is unauthenticated and always on — scrape
# it on a trusted network, bind cellar to localhost, or gate /metrics at your
# reverse proxy. GET /health stays a public liveness probe.

# --- two-factor auth (TOTP, optional) ---
# off (default) = the feature is inert; "optional" enables it. Per-user: only
# users who enroll AND confirm get a second login step (a 6-digit authenticator
# code), so enabling it doesn't disrupt anyone who hasn't opted in. Set this for
# apps that want 2FA available (e.g. anything handling payments). Confirming
# enrollment returns one-time recovery codes (usable in place of a code if the
# authenticator is lost; regenerate via POST /auth/mfa/recovery-codes). Admin
# lockout recovery of last resort: `cellar mfa-reset <email>`.
# CEL_MFA=optional

# --- federated sign-in (OIDC: Google / Apple / generic, optional) ---
# Enable providers by name; for google/apple the issuer + JWKS are built in, so
# you only set the client id (the OAuth audience). The mobile/web client obtains
# an ID token from the provider and POSTs it to /auth/oauth {provider, id_token};
# cellar verifies the signature against the provider's keys and finds-or-links
# the account. A verified email matching an existing user links to it; otherwise
# a new user is auto-provisioned with the default signup role (if one is set).
# CEL_OAUTH_PROVIDERS=google,apple
# CEL_OAUTH_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# CEL_OAUTH_APPLE_CLIENT_ID=com.example.app
# A generic OIDC provider needs all three:
# CEL_OAUTH_PROVIDERS=myidp
# CEL_OAUTH_MYIDP_ISSUER=https://idp.example.com
# CEL_OAUTH_MYIDP_JWKS=https://idp.example.com/.well-known/jwks.json
# CEL_OAUTH_MYIDP_CLIENT_ID=my-client-id

# --- email / SMTP (optional) ---
# Outbound email via libcurl (no extra dependency). Inert unless URL + From are
# set. Point at any SMTP relay or transactional-email provider. STARTTLS is
# required by default (use a smtps:// URL for implicit TLS). Verify the config
# with:  cellar send-test-mail you@example.com
#
# >>> DELIVERABILITY: relay, do NOT send direct. <<<
# Sending mail straight from this server's IP — especially a home/residential box
# behind the tunnel — lands in spam or is rejected outright by Gmail/Outlook/Yahoo
# (untrusted IP, no rDNS reputation, missing DKIM). Point CEL_SMTP_URL at a
# transactional-email provider (Amazon SES, Postmark, Resend, Brevo, Mailjet,
# SMTP2GO, SendGrid…) — most have a free tier that easily covers verify-email +
# password-reset volume, and they own the IP reputation + sign DKIM for you. Then
# set up DNS for your sending domain (one-time): SPF, DKIM (the provider's key),
# and DMARC (start p=none). Direct send is fine only for local testing (MailHog/
# Mailpit). Self-hosting an MTA for your own mail is possible but a permanent
# reputation chore (and Outlook fights small senders) — relaying is the sane default.
# Want the sovereign path anyway? Full runbook: docs/email-mta-setup.md
# CEL_SMTP_URL=smtps://smtp.your-provider.com:465
# CEL_SMTP_USER=apikey
# CEL_SMTP_PASS=secret
# CEL_SMTP_TLS=require            # require (default) | try | none
# CEL_MAIL_FROM=noreply@example.com
# CEL_MAIL_FROM_NAME=Acme
# Base URL of your frontend; used to build the links in password-reset and
# email-verification messages (<CEL_APP_URL>/reset-password?token=... and
# /verify-email?token=...). If unset, the email includes the raw token instead.
#   reset:   POST /auth/password/forgot {email} -> /auth/password/reset {token,password}
#   verify:  sent on register -> POST /auth/verify-email {token}
#            (POST /auth/verify-email/resend re-sends for the logged-in user)
# A verification email is sent on register; logins expose user.email_verified.
# CEL_APP_URL=https://app.example.com

# --- session cache (optional; scaling) ---
# Seconds to cache a verified token in memory (skips the per-request auth DB hit).
# 0 (default) = always hit the DB (instant revocation). Logout always evicts.
# CEL_SESSION_CACHE_TTL=0

# --- auth rate limiting (per client IP) ---
# Throttle the expensive /auth/login + /auth/register (Argon2id) endpoints:
# "N/W" = N requests per W seconds per IP, then 429. "0" disables. Default 10/60.
# Behind a proxy, set CEL_TRUST_PROXY=1 so the limit keys on the real client IP.
# CEL_AUTH_RATELIMIT=10/60

# --- request / DoS limits ---
# Max request body in bytes; larger -> 413 before the JSON parser runs (default
# 1 MiB). Raise for bulk imports; lower to tighten.
# CEL_MAX_BODY=1048576
# Seconds a connection may sit mid-handshake / mid-headers before it's reaped
# (slowloris guard; default 15). Legit clients finish in well under a second.
# CEL_HEADER_TIMEOUT=15
# (Other fixed limits: <= 64 request headers / 32 KiB of headers -> 431; LIST
#  returns at most 1000 rows; password length capped at 128.)

# --- account lockout (per account, optional) ---
# "N/W" = after N failed password logins within W seconds, lock the account for W
# seconds (a correct password is refused while locked). "0" (default) disables it
# — the per-IP rate limit above is the primary defense; lockout adds a per-account
# layer at the cost of a possible lock-out-the-victim DoS, so it is opt-in. Clear a
# lock with: cellar unlock <email>
# CEL_AUTH_LOCKOUT=5/900

# --- app database (SQLite) ---
# cellar stores each app as a single SQLite file (schema + data + identity). Point
# this at the app's database file; it's created on first run and the identity
# tables are applied automatically. (Per-app request routing to many bundles is a
# later feature; for now one app is served.)
CEL_DATA_DB=/var/lib/cellar/cellar.db

# --- authorization (optional) ---
# Per-table policy overrides incl. row-level ownership. If unset, built-in role
# defaults apply (admin=all, editor=read+create+update, viewer=read).
# CEL_POLICY_FILE=/etc/cellar/policies.json

# --- first-run seeding (optional; remove once the admin exists) ---
# CEL_SEED_ADMIN=admin@example.com:change-me
# CEL_SEED_USERS=admin@example.com:change-me:admin;editor@example.com:pw:editor
