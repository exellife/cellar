[Unit]
Description=cellar — schema-driven SQLite backend
Documentation=https://github.com/exellife/cellar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cellar
Group=cellar
# Configuration lives in this env file (CEL_* variables). See cellar.env.example.
EnvironmentFile=/etc/cellar/cellar.env
# The app's SQLite database lives here (systemd creates /var/lib/cellar, owned by
# the service user). Point CEL_DATA_DB at a file under it; the schema is applied
# on startup. The web UI and identity tables need no separate migration step.
StateDirectory=cellar
ExecStart=/usr/local/bin/cellar
Restart=on-failure
RestartSec=2

# --- hardening: cellar writes only its SQLite database (under StateDirectory);
#     web assets are embedded and logs go to journald, so lock the rest down. ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
