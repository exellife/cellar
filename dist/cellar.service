[Unit]
Description=cellar — schema-driven Postgres backend
Documentation=https://github.com/exellife/cellar
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cellar
Group=cellar
# Configuration lives in this env file (CEL_* variables). See cellar.env.example.
EnvironmentFile=/etc/cellar/cellar.env
# Apply any pending migrations before starting (fails the unit if the DB is down).
ExecStartPre=/usr/local/bin/cellar migrate
ExecStart=/usr/local/bin/cellar
Restart=on-failure
RestartSec=2

# --- hardening: cellar needs no filesystem writes (assets+migrations embedded,
#     logs go to journald), so lock the sandbox down. ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
