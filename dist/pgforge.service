[Unit]
Description=pgforge — schema-driven Postgres backend
Documentation=https://github.com/exellife/pgforge
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pgforge
Group=pgforge
# Configuration lives in this env file (PGF_* variables). See pgforge.env.example.
EnvironmentFile=/etc/pgforge/pgforge.env
# Apply any pending migrations before starting (fails the unit if the DB is down).
ExecStartPre=/usr/local/bin/pgforge migrate
ExecStart=/usr/local/bin/pgforge
Restart=on-failure
RestartSec=2

# --- hardening: pgforge needs no filesystem writes (assets+migrations embedded,
#     logs go to journald), so lock the sandbox down. ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
