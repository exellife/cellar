# build outputs
/build/
/build-*/
*.o
*.a
*.so
*.out

# a future portico submodule lives here; the sibling ../portico is not part of this repo
/external/

# editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# local secrets / overrides (never commit)
config/policies.local.json
.env

# headless UI test deps (dev only)
/tests/ui/node_modules/

# local staging for deps not yet vendored in third_party/ (e.g. LuaJIT .debs/spike);
# SQLite is now vendored at third_party/sqlite, so nothing here is needed to build
/build-deps/

# downloaded packages (e.g. staged SQLite dev files)
*.deb

# app SQLite databases (created at runtime)
*.db
*.db-wal
*.db-shm

# example + app bundles: throwaway provisioned runtime state (data.db, copied bundle)
examples/*/.run/
apps/*/.run/
